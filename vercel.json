{
  "version": 2,
  "builds": [
    {
      "src": "client/package.json",  // Adjust the path if needed
      "use": "@vercel/static-build",  // Use static build for React app
      "config": {
        "distDir": "dist"  // Vite's default build directory
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/client/$1"  // Route to your React app's directory
    }
  ]
}
